generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum TipoIdentificacion {
  CEDULA
  PASAPORTE
  RESIDENCIA
}

enum Sexo {
  MASCULINO
  FEMENINO
}

enum EstadoCivil {
  SOLTERO
  CASADO
  DIVORCIADO
  VIUDO
}

enum CategoriaTratamiento {
  PREVENTIVO
  CIRUGIA
  RESTAURACION
  ORTODONCIA
}

enum EstadoCita {
  PENDIENTE
  ATENDIDA
  CANCELADA
}

enum AccionBitacora {
  INICIO_SESION
  CREACION
  ACTUALIZACION
  ELIMINACION
  CONSULTA
}

// --- Models ---

model Clinic {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(255)
  direccion String   @db.VarChar(500)
  telefono  String   @db.VarChar(50)
  email     String?  @db.VarChar(255)
  estado    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patients Patient[]
  users    User[]

  @@map("clinics")
}

model Role {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(100)
  descripcion String?  @db.Text
  esAdmin     Boolean  @default(false) @map("es_admin")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users    User[]
  features RoleFeature[]

  @@map("roles")
}


model Feature {
  id          Int      @id @default(autoincrement())
  clave       String   @unique @db.VarChar(100)
  nombre      String   @db.VarChar(200)
  descripcion String?  @db.Text
  modulo      String   @db.VarChar(100)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  roles RoleFeature[]

  @@map("features")
}

model RoleFeature {
  id        Int @id @default(autoincrement())
  rolId     Int @map("rol_id")
  featureId Int @map("feature_id")

  rol     Role    @relation(fields: [rolId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([rolId, featureId])
  @@map("role_features")
}

model User {
  id                     Int                @id @default(autoincrement())
  usuario                String             @unique @db.VarChar(100)
  nombre                 String             @db.VarChar(255)
  passwordHash           String             @map("password_hash") @db.VarChar(255)
  rolId                  Int                @map("rol_id")
  tipoIdentificacion     TipoIdentificacion @map("tipo_identificacion")
  numeroIdentificacion   String             @map("numero_identificacion") @db.VarChar(50)
  sexo                   Sexo
  especialidad           String?            @db.VarChar(255)
  clinicaId              Int                @map("clinica_id")
  fotografia             String?            @db.VarChar(500)
  email                  String?            @db.VarChar(255)
  telefono               String?            @db.VarChar(20)
  // Doctor-specific fields
  codigoProfesional      String?            @map("codigo_profesional") @db.VarChar(100)
  duracionCitas          Int?               @map("duracion_citas")
  color                  String?            @db.VarChar(7)
  // Google Calendar integration (doctor-specific)
  googleCalendarActivo   Boolean            @default(false) @map("google_calendar_activo")
  googleCalendarEmail    String?            @map("google_calendar_email") @db.VarChar(255)
  googleClientId         String?            @map("google_client_id") @db.VarChar(500)
  googleClientSecret     String?            @map("google_client_secret") @db.VarChar(500)
  estado                 Boolean            @default(true)
  ultimoAcceso           DateTime?          @map("ultimo_acceso")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  rol           Role           @relation(fields: [rolId], references: [id])
  clinica       Clinic         @relation(fields: [clinicaId], references: [id])
  patients      Patient[]
  consultations Consultation[]
  appointments  Appointment[]
  auditLogs     AuditLog[]

  DentistaContratos  Contrato[]   @relation("DentistaContratos")
  CreadoPorContratos Contrato[]   @relation("CreadoPorContratos")
  PagosRegistrados   ContratoPago[] @relation("PagosRegistrados")

  @@map("users")
}

model Patient {
  id                          Int                @id @default(autoincrement())
  nombre                      String             @db.VarChar(255)
  apellido1                   String             @db.VarChar(255)
  apellido2                   String?            @db.VarChar(255)
  tipoIdentificacion          TipoIdentificacion @map("tipo_identificacion")
  numeroIdentificacion        String             @unique @map("numero_identificacion") @db.VarChar(50)
  telefonoCelular             String             @map("telefono_celular") @db.VarChar(50)
  telefonoCasa                String?            @map("telefono_casa") @db.VarChar(50)
  telefonoTrabajo             String?            @map("telefono_trabajo") @db.VarChar(50)
  otroTelefono                String?            @map("otro_telefono") @db.VarChar(50)
  sexo                        Sexo
  estadoCivil                 EstadoCivil        @map("estado_civil")
  direccion                   String             @db.VarChar(500)
  email                       String?            @db.VarChar(255)
  ocupacion                   String?            @db.VarChar(255)
  fechaNacimiento             DateTime           @map("fecha_nacimiento")
  tipoSangre                  String?            @map("tipo_sangre") @db.VarChar(10)
  clinicaId                   Int                @map("clinica_id")
  profesionalId               Int                @map("profesional_id")
  antecedentesPatologicos     String?            @map("antecedentes_patologicos") @db.Text
  antecedentesNoPatologicos   Json?              @map("antecedentes_no_patologicos")
  antecedentesQuirurgicos     String?            @map("antecedentes_quirurgicos") @db.Text
  antecedentesGinecoObstetricos Json?            @map("antecedentes_gineco_obstetricos")
  antecedentesHeredoFamiliares String?           @map("antecedentes_heredo_familiares") @db.Text
  antecedentesOtros           String?            @map("otros_antecedentes") @db.Text
  notas                       String?            @db.Text
  estado                      Boolean            @default(true)
  createdAt                   DateTime           @default(now()) @map("created_at")
  updatedAt                   DateTime           @updatedAt @map("updated_at")

  clinica       Clinic         @relation(fields: [clinicaId], references: [id])
  profesional   User           @relation(fields: [profesionalId], references: [id])
  consultations Consultation[]
  appointments  Appointment[]
  files         PatientFile[]
  contratos     Contrato[]

  @@index([clinicaId, createdAt(sort: Desc)])
  @@index([clinicaId, nombre, apellido1, apellido2])
  @@index([clinicaId, numeroIdentificacion])
  @@map("patients")
}

model AppointmentType {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(255)
  duracion  Int
  estado    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  appointments Appointment[]

  @@map("appointment_types")
}

model Treatment {
  id        Int                  @id @default(autoincrement())
  codigo    String               @unique @db.VarChar(50)
  nombre    String               @db.VarChar(255)
  categoria CategoriaTratamiento
  precio    Decimal              @db.Decimal(10, 2)
  estado    Boolean              @default(true)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  contratoTratamientos ContratoTratamiento[]

  @@map("treatments")
}

model Consultation {
  id                       Int      @id @default(autoincrement())
  pacienteId               Int      @map("paciente_id")
  profesionalId            Int      @map("profesional_id")
  citaId                   Int?     @unique @map("cita_id")
  fecha                    DateTime
  ocultar                  Boolean  @default(false)
  peso                     Decimal? @db.Decimal(5, 2)
  talla                    Decimal? @db.Decimal(5, 2)
  imc                      Decimal? @db.Decimal(5, 2)
  temperatura              Decimal? @db.Decimal(4, 1)
  presionArterial          String?  @map("presion_arterial") @db.VarChar(20)
  frecuenciaCardiaca       Int?     @map("frecuencia_cardiaca")
  frecuenciaRespiratoria   Int?     @map("frecuencia_respiratoria")
  satO2                    Decimal? @map("sat_o2") @db.Decimal(5, 2)
  motivoConsulta           String?  @map("motivo_consulta") @db.Text
  examenFisico             String?  @map("examen_fisico") @db.Text
  impresionDiagnostica     String?  @map("impresion_diagnostica") @db.Text
  indicacionesTratamientos String?  @map("indicaciones_tratamientos") @db.Text
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  paciente    Patient              @relation(fields: [pacienteId], references: [id])
  profesional User                 @relation(fields: [profesionalId], references: [id])
  cita        Appointment?         @relation(fields: [citaId], references: [id])
  images      ConsultationImage[]
  files       PatientFile[]

  @@map("consultations")
}

model ConsultationImage {
  id          Int      @id @default(autoincrement())
  consultaId  Int      @map("consulta_id")
  fileName    String   @map("file_name") @db.VarChar(255)
  storagePath String   @map("storage_path") @db.VarChar(500)
  fileSize    Int      @map("file_size")
  mimeType    String   @map("mime_type") @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  consulta Consultation @relation(fields: [consultaId], references: [id], onDelete: Cascade)

  @@map("consultation_images")
}

model PatientFile {
  id          Int      @id @default(autoincrement())
  pacienteId  Int      @map("paciente_id")
  consultaId  Int?     @map("consulta_id")
  fileName    String   @map("file_name") @db.VarChar(255)
  storagePath String   @map("storage_path") @db.VarChar(500)
  fileSize    Int      @map("file_size")
  mimeType    String   @map("mime_type") @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  paciente Patient       @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  consulta Consultation? @relation(fields: [consultaId], references: [id], onDelete: SetNull)

  @@map("patient_files")
}

model Appointment {
  id             Int        @id @default(autoincrement())
  pacienteId     Int        @map("paciente_id")
  profesionalId  Int        @map("profesional_id")
  tipoCitaId     Int        @map("tipo_cita_id")
  fecha          DateTime   @db.Date
  horaInicio     String     @map("hora_inicio") @db.VarChar(10)
  horaFin        String     @map("hora_fin") @db.VarChar(10)
  notas          String?    @db.Text
  estado         EstadoCita @default(PENDIENTE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  paciente    Patient         @relation(fields: [pacienteId], references: [id])
  profesional User            @relation(fields: [profesionalId], references: [id])
  tipoCita    AppointmentType @relation(fields: [tipoCitaId], references: [id])
  consulta    Consultation?

  @@map("appointments")
}

model AuditLog {
  id        Int             @id @default(autoincrement())
  fecha     DateTime        @default(now())
  usuarioId Int?            @map("usuario_id")
  usuario   String          @db.VarChar(100)
  accion    AccionBitacora
  modulo    String          @db.VarChar(100)
  ip        String?         @db.VarChar(50)
  detalle   String?         @db.Text
  createdAt DateTime        @default(now()) @map("created_at")

  usuarioRef User? @relation(fields: [usuarioId], references: [id])

  @@map("audit_logs")
}

model SystemConfig {
  id                    Int      @id @default(1)
  nombreSistema         String   @map("nombre_sistema") @db.VarChar(255)
  zonaHoraria           String   @map("zona_horaria") @db.VarChar(100)
  formatoFecha          String   @map("formato_fecha") @db.VarChar(50)
  duracionCitaDefecto   Int      @map("duracion_cita_defecto")
  horaInicioJornada     String   @map("hora_inicio") @db.VarChar(10)
  horaFinJornada        String   @map("hora_fin") @db.VarChar(10)
  restriccionHorario    Boolean  @default(false) @map("restriccion_horario")
  registrarBitacora     Boolean  @default(true) @map("registrar_bitacora")
  requerirCambioClave   Boolean  @default(false) @map("requerir_cambio_clave")
  tiempoInactividad     Int      @default(30) @map("tiempo_inactividad")
  enviarRecordatorioEmail Boolean @default(false) @map("recordatorio_email")
  notificarMedicoCitas  Boolean  @default(false) @map("notificar_medico")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

// --- Contratos Module ---

enum EstadoContrato {
  BORRADOR
  ACTIVO
  PAUSADO
  COMPLETADO
  CANCELADO
}

enum EstadoItem {
  PROPUESTO
  ACEPTADO
  EN_CURSO
  FINALIZADO
  CANCELADO
}

enum Periodicidad {
  SEMANAL
  QUINCENAL
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum TipoPago {
  EFECTIVO
  TARJETA
  SINPE
  TRANSFERENCIA
  CHEQUE
  OTRO
}

enum EstadoPago {
  APLICADO
  ANULADO
}

enum AccionContrato {
  CREACION
  ACTIVACION
  MODIFICACION
  ESTADO_CAMBIADO
  TRATAMIENTO_AGREGADO
  TRATAMIENTO_MODIFICADO
  TRATAMIENTO_ELIMINADO
  PAGO_REGISTRADO
  PAGO_ANULADO
}

model Contrato {
  id           String         @id @default(cuid())
  numero       String         @unique
  pacienteId   Int
  dentistaId   Int
  clinicaId    Int
  fecha        DateTime
  descripcion  String?        @db.Text
  estado       EstadoContrato @default(BORRADOR)
  moneda       String         @default("CRC")
  plazo        Int?
  periodicidad Periodicidad?
  notas        String?        @db.Text
  creadoPorId  Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  paciente     Patient              @relation(fields: [pacienteId], references: [id])
  dentista     User                 @relation("DentistaContratos", fields: [dentistaId], references: [id])
  creadoPor    User                 @relation("CreadoPorContratos", fields: [creadoPorId], references: [id])
  tratamientos ContratoTratamiento[]
  pagos        ContratoPago[]
  historial    ContratoHistorial[]
}

model ContratoTratamiento {
  id             String     @id @default(cuid())
  contratoId     String
  tratamientoId  Int
  pieza          String?
  cantidad       Int        @default(1)
  precioUnitario Decimal    @db.Decimal(10, 2)
  descuento      Decimal    @db.Decimal(10, 2) @default(0)
  subtotal       Decimal    @db.Decimal(10, 2)
  estadoItem     EstadoItem @default(PROPUESTO)
  fechaPropuesta DateTime?
  observaciones  String?
  createdAt      DateTime   @default(now())

  contrato    Contrato  @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  tratamiento Treatment @relation(fields: [tratamientoId], references: [id])
}

model ContratoPago {
  id              String     @id @default(cuid())
  contratoId      String
  fecha           DateTime
  monto           Decimal    @db.Decimal(10, 2)
  tipoPago        TipoPago
  estado          EstadoPago @default(APLICADO)
  concepto        String?
  referencia      String?
  numeroFactura   String?
  autorizacion    String?
  notas           String?
  motivoAnulacion String?
  registradoPorId Int

  createdAt DateTime @default(now())

  contrato      Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  registradoPor User     @relation("PagosRegistrados", fields: [registradoPorId], references: [id])
}

model ContratoHistorial {
  id            String         @id @default(cuid())
  contratoId    String
  accion        AccionContrato
  descripcion   String
  usuarioId     Int
  nombreUsuario String
  detalle       Json?
  createdAt     DateTime       @default(now())

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
}
