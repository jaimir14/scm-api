{
  "name": "api-backend",
  "version": "1.0.0",
  "description": "Backend API service - Fastify + Prisma + MySQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "prisma:url": "tsx prisma/load-env.ts",
    "prisma:generate": "DATABASE_URL=$(npx tsx prisma/load-env.ts) prisma generate",
    "prisma:migrate": "DATABASE_URL=$(npx tsx prisma/load-env.ts) prisma migrate dev",
    "prisma:migrate:deploy": "DATABASE_URL=$(npx tsx prisma/load-env.ts) prisma migrate deploy",
    "prisma:studio": "DATABASE_URL=$(npx tsx prisma/load-env.ts) prisma studio",
    "prisma:migrate:all": "tsx prisma/migrate-all-tenants.ts",
    "prisma:migrate:all:dry": "tsx prisma/migrate-all-tenants.ts --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
