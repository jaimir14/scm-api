# Server
PORT=3000
NODE_ENV=development

# Database - each client gets their own schema (DB_NAME)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=clinic_client_001

# Prisma requires this — just update the values above and mirror them here
DATABASE_URL=mysql://root:your_password@localhost:3306/clinic_client_001

# JWT
JWT_SECRET=your-super-secret-key-minimum-32-characters-long
JWT_EXPIRES_IN=1h

# DigitalOcean Spaces (S3-compatible) - per tenant bucket
SPACES_REGION=nyc3
SPACES_BUCKET=scm-your-tenant-assets
SPACES_ACCESS_KEY=your-spaces-access-key
SPACES_SECRET_KEY=your-spaces-secret-key
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
